# Copiez ce fichier en ".env.local" puis remplissez les valeurs.
# ".env.local" n'est jamais envoyé sur GitHub. Ne collez aucune clé dans une conversation.

# Adresse de votre projet Supabase (Supabase > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Clé "publishable" (ou "anon") de Supabase. Elle est publique par conception :
# elle ne donne aucun droit par elle-même, la sécurité repose sur la RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adresse publique de l'application, sans barre oblique finale.
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tests de base de données uniquement (facultatif, valeur par défaut ci-dessous).
# TEST_DATABASE_URL=postgres://cashpilot_test:cashpilot_test@localhost:5432/cashpilot_test
